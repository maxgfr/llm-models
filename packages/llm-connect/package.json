{
  "name": "llm-connect",
  "version": "2.3.1",
  "description": "Connect a web app to any LLM provider through the AI SDK: provider registry, model creation, connection test, a settings store and speech-to-text (provider models, or NVIDIA Parakeet, Canary and Whisper in the page), with a React adapter",
  "author": "maxgfr",
  "license": "MIT",
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./react": {
      "types": "./build/react.d.ts",
      "default": "./build/react.js"
    },
    "./whisper": {
      "types": "./build/whisper.d.ts",
      "default": "./build/whisper.js"
    },
    "./nemo": {
      "types": "./build/nemo.d.ts",
      "default": "./build/nemo.js"
    },
    "./providers/*": {
      "types": "./build/providers/*.d.ts",
      "default": "./build/providers/*.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxgfr/llm-models.git",
    "directory": "packages/llm-connect"
  },
  "bugs": {
    "url": "https://github.com/maxgfr/llm-models/issues"
  },
  "homepage": "https://github.com/maxgfr/llm-models/tree/main/packages/llm-connect#readme",
  "files": [
    "build"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "llm",
    "ai",
    "ai-sdk",
    "byok",
    "openai",
    "anthropic",
    "ollama",
    "lm-studio",
    "react",
    "svelte",
    "browser",
    "transcription",
    "speech-to-text",
    "whisper",
    "parakeet",
    "canary",
    "nvidia"
  ],
  "scripts": {
    "build": "rm -rf build && tsc",
    "build:all": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "release": "semantic-release"
  },
  "dependencies": {
    "llm-models": "workspace:^"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "@ai-sdk/anthropic": "^4.0.0",
    "@ai-sdk/google": "^4.0.0",
    "@ai-sdk/mistral": "^4.0.0",
    "@ai-sdk/openai": "^4.0.0",
    "@ai-sdk/openai-compatible": "^3.0.0",
    "react": ">=18",
    "@huggingface/transformers": "^4.0.0",
    "onnxruntime-web": ">=1.22.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/mistral": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "@ai-sdk/openai-compatible": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@huggingface/transformers": {
      "optional": true
    },
    "onnxruntime-web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.82",
    "@ai-sdk/google": "^4.0.99",
    "@ai-sdk/mistral": "^4.0.66",
    "@ai-sdk/openai": "^4.0.96",
    "@ai-sdk/openai-compatible": "^3.0.71",
    "@happy-dom/global-registrator": "^21.0.3",
    "@huggingface/transformers": "^4.3.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.7",
    "ai": "^7.0.143",
    "fake-indexeddb": "^6.2.6",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.4.3"
  }
}
