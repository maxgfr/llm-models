{
  "name": "llm-connect",
  "version": "0.0.0-development",
  "description": "Connect a web app to any LLM provider through the AI SDK: provider registry, model creation, connection test and a settings store, with a React adapter",
  "author": "maxgfr",
  "license": "MIT",
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./react": {
      "types": "./build/react.d.ts",
      "default": "./build/react.js"
    },
    "./providers/*": {
      "types": "./build/providers/*.d.ts",
      "default": "./build/providers/*.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxgfr/llm-models.git",
    "directory": "packages/llm-connect"
  },
  "bugs": {
    "url": "https://github.com/maxgfr/llm-models/issues"
  },
  "homepage": "https://github.com/maxgfr/llm-models/tree/main/packages/llm-connect#readme",
  "files": [
    "build"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "llm",
    "ai",
    "ai-sdk",
    "byok",
    "openai",
    "anthropic",
    "ollama",
    "lm-studio",
    "react",
    "svelte",
    "browser"
  ],
  "scripts": {
    "build": "rm -rf build && tsc",
    "build:all": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "release": "semantic-release"
  },
  "dependencies": {
    "llm-models": "workspace:^"
  },
  "peerDependencies": {
    "ai": "^6.0.0",
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/google": "^3.0.0",
    "@ai-sdk/mistral": "^3.0.0",
    "@ai-sdk/openai": "^3.0.0",
    "@ai-sdk/openai-compatible": "^2.0.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/mistral": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "@ai-sdk/openai-compatible": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^3.0.132",
    "@ai-sdk/google": "^3.0.134",
    "@ai-sdk/mistral": "^3.0.73",
    "@ai-sdk/openai": "^3.0.129",
    "@ai-sdk/openai-compatible": "^2.0.84",
    "@happy-dom/global-registrator": "^21.0.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.7",
    "ai": "^6.0.308",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.4.3"
  }
}
