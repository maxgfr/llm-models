{
  "name": "llm-models",
  "version": "1.16.0",
  "author": "maxgfr",
  "license": "MIT",
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "browser": "./build/browser.js",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "browser": "./build/browser.js",
      "default": "./build/index.js"
    },
    "./browser": {
      "types": "./build/browser.d.ts",
      "default": "./build/browser.js"
    },
    "./catalog": {
      "types": "./build/catalog.d.ts",
      "default": "./build/catalog.js"
    },
    "./video": {
      "types": "./build/video.d.ts",
      "default": "./build/video.js"
    },
    "./image": {
      "types": "./build/image.d.ts",
      "default": "./build/image.js"
    },
    "./speech": {
      "types": "./build/speech.d.ts",
      "default": "./build/speech.js"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "description": "Fetch latest LLM, video, image and speech models from OpenRouter, models.dev, the AI Gateway, fal.ai and ElevenLabs, in Node.js or the browser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxgfr/llm-models.git",
    "directory": "packages/llm-models"
  },
  "bugs": {
    "url": "https://github.com/maxgfr/llm-models/issues"
  },
  "homepage": "https://github.com/maxgfr/llm-models/tree/main/packages/llm-models#readme",
  "files": [
    "build",
    "bin"
  ],
  "bin": {
    "llm-models": "bin/llm-models.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "llm",
    "models",
    "openrouter",
    "ai",
    "machine-learning",
    "api",
    "cli",
    "zod",
    "browser",
    "cors",
    "webgpu",
    "webllm",
    "video",
    "text-to-video",
    "image",
    "text-to-image",
    "speech",
    "text-to-speech",
    "tts"
  ],
  "scripts": {
    "start": "bun run src/bin.ts",
    "dev": "bun run --watch src/bin.ts",
    "build": "bun build src/index.ts --outdir build --target node && bun build src/browser.ts --outdir build --target browser && bun build src/catalog.ts --outdir build --target browser && bun build src/video.ts --outdir build --target browser && bun build src/image.ts --outdir build --target browser && bun build src/speech.ts --outdir build --target browser",
    "build:types": "tsc --emitDeclarationOnly",
    "build:all": "bun run build && bun run build:types",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "biome check src/ scripts/",
    "lint:fix": "biome check --write src/ scripts/",
    "format": "biome format --write src/ scripts/",
    "release": "semantic-release",
    "catalog:browser": "bun run scripts/build-browser-models.ts",
    "build:binary:linux-x64": "bun build src/bin.ts --compile --target=bun-linux-x64 --outfile dist/llm-models-linux-x64",
    "build:binary:linux-arm64": "bun build src/bin.ts --compile --target=bun-linux-arm64 --outfile dist/llm-models-linux-arm64",
    "build:binary:macos-x64": "bun build src/bin.ts --compile --target=bun-darwin-x64 --outfile dist/llm-models-macos-x64",
    "build:binary:macos-arm64": "bun build src/bin.ts --compile --target=bun-darwin-arm64 --outfile dist/llm-models-macos-arm64",
    "build:binary:win-x64": "bun build src/bin.ts --compile --target=bun-windows-x64 --outfile dist/llm-models-win-x64.exe",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "commander": "^15.0.0",
    "zod": "^4.6.6"
  }
}
