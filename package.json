{
  "name": "llm-models",
  "version": "1.8.0",
  "author": "maxgfr",
  "license": "MIT",
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "browser": "./build/browser.js",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "browser": "./build/browser.js",
      "default": "./build/index.js"
    },
    "./browser": {
      "types": "./build/browser.d.ts",
      "default": "./build/browser.js"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "description": "Fetch latest LLM models from OpenRouter and models.dev APIs, in Node.js or the browser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxgfr/llm-models.git"
  },
  "bugs": {
    "url": "https://github.com/maxgfr/llm-models/issues"
  },
  "homepage": "https://github.com/maxgfr/llm-models#readme",
  "files": [
    "build"
  ],
  "bin": {
    "llm-models": "build/index.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "llm",
    "models",
    "openrouter",
    "ai",
    "machine-learning",
    "api",
    "cli",
    "zod",
    "browser",
    "cors",
    "webgpu",
    "webllm"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir build --target node && bun build src/browser.ts --outdir build --target browser",
    "build:types": "tsc --emitDeclarationOnly",
    "build:all": "bun run build && bun run build:types",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "biome check src/ scripts/",
    "lint:fix": "biome check --write src/ scripts/",
    "format": "biome format --write src/ scripts/",
    "release": "semantic-release",
    "catalog:browser": "bun run scripts/build-browser-models.ts",
    "build:binary:linux-x64": "bun build src/index.ts --compile --target=bun-linux-x64 --outfile dist/llm-models-linux-x64",
    "build:binary:linux-arm64": "bun build src/index.ts --compile --target=bun-linux-arm64 --outfile dist/llm-models-linux-arm64",
    "build:binary:macos-x64": "bun build src/index.ts --compile --target=bun-darwin-x64 --outfile dist/llm-models-macos-x64",
    "build:binary:macos-arm64": "bun build src/index.ts --compile --target=bun-darwin-arm64 --outfile dist/llm-models-macos-arm64",
    "build:binary:win-x64": "bun build src/index.ts --compile --target=bun-windows-x64 --outfile dist/llm-models-win-x64.exe"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "bun-types": "^1.3.14",
    "semantic-release": "^25.0.8",
    "typescript": "^7.0.2"
  }
}
